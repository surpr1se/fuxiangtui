/* pages/upload/upload.wxss */
.upload-header {
  text-align: center;
  padding: 40rpx 0;
}

.upload-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.upload-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.upload-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  padding: 0 40rpx;
}

.upload-area {
  border: 2rpx dashed #FF8E53;
  border-radius: 32rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  background: #FFF8F0;
  margin-bottom: 32rpx;
}

.upload-area:active {
  background: #FFF0E5;
}

.upload-area-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.upload-area-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF6B6B;
  margin-bottom: 16rpx;
}

.upload-area-desc {
  font-size: 24rpx;
  color: #999;
}

.file-info {
  background: #F0FDF4;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.file-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #065F46;
  margin-bottom: 16rpx;
}

.file-size {
  font-size: 24rpx;
  color: #059669;
}

.upload-progress {
  margin-bottom: 32rpx;
}

.progress-bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B, #FF8E53);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.tips-card {
  background: #FFFBEB;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400E;
  margin-bottom: 24rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #78350F;
  line-height: 1.5;
}

.demo-entry {
  text-align: center;
  color: #10B981;
  font-size: 26rpx;
  padding: 24rpx;
  text-decoration: underline;
  margin-top: 16rpx;
}

.btn-full {
  width: 100%;
}
