/* pages/history/history.wxss */
.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 8rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.history-count {
  font-size: 24rpx;
  color: #999;
}

.history-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.history-card:active {
  transform: scale(0.98);
}

.history-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-date {
  font-size: 24rpx;
  color: #999;
}

.history-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.history-info {
  display: flex;
  justify-content: space-between;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}
