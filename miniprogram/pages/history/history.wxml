<!--pages/history/history.wxml-->
<view class="container">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{historyList.length === 0}}">
    <view class="empty-icon">📋</view>
    <view class="empty-title">暂无测算记录</view>
    <view class="empty-desc">快去开始测算吧</view>
    <button class="btn-primary" bindtap="goCalculate">开始测算</button>
  </view>

  <!-- 历史记录列表 -->
  <view wx:if="{{historyList.length > 0}}">
    <view class="history-header">
      <text class="history-title">历史测算记录</text>
      <text class="history-count">共{{historyList.length}}条</text>
    </view>
    
    <view 
      class="history-card" 
      wx:for="{{historyList}}" 
      wx:key="id"
      bindtap="viewDetail"
      data-index="{{index}}"
    >
      <view class="history-top">
        <text class="history-date">{{item.createTime}}</text>
        <text class="history-amount">¥{{item.result.pensionDetails.totalMonthlyPension}}</text>
      </view>
      <view class="history-info">
        <view class="info-item">
          <text class="info-label">退休年龄</text>
          <text class="info-value">{{item.result.basicInfo.retireAge}}岁</text>
        </view>
        <view class="info-item">
          <text class="info-label">累计缴费</text>
          <text class="info-value">{{item.result.basicInfo.totalPaymentYears}}年</text>
        </view>
        <view class="info-item">
          <text class="info-label">平均指数</text>
          <text class="info-value">{{item.result.basicInfo.avgPaymentIndex}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
