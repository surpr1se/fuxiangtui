<!--pages/guide/guide.wxml-->
<view class="container">
  <!-- 头部 -->
  <view class="guide-header">
    <view class="guide-icon">📍</view>
    <view class="guide-title">福建省退休办理指南</view>
  </view>

  <!-- 办理条件 -->
  <view class="guide-card">
    <view class="guide-card-title">📋 办理条件</view>
    <view class="guide-card-content">
      <view class="condition-item">
        <text class="check-icon">✓</text>
        <text class="condition-text">达到法定退休年龄（男60岁、女工人50岁、女干部55岁）</text>
      </view>
      <view class="condition-item">
        <text class="check-icon">✓</text>
        <text class="condition-text">累计缴费年限满15年及以上</text>
      </view>
    </view>
  </view>

  <!-- 办理材料 -->
  <view class="guide-card">
    <view class="guide-card-title">📝 办理材料</view>
    <view class="guide-card-content">
      <view class="material-item">1. 身份证原件及复印件</view>
      <view class="material-item">2. 户口簿原件及复印件</view>
      <view class="material-item">3. 近期1寸免冠照片1张</view>
      <view class="material-item">4. 职工档案（企业职工需提供）</view>
      <view class="material-item">5. 《福建省参保人员基本养老金领取资格认定表</view>
    </view>
  </view>

  <!-- 各地社保机构 -->
  <view class="guide-card">
    <view class="guide-card-title">🏢 各地市社保经办机构</view>
    <view class="office-list">
      <view class="office-item" wx:for="{{officeList}}" wx:key="name">
        <view class="office-name">{{item.name}}</view>
        <view class="office-address">📍 {{item.address}}</view>
        <view class="office-phone">📞 {{item.phone}}</view>
      </view>
    </view>
  </view>

  <!-- 常见问题 -->
  <view class="guide-card">
    <view class="guide-card-title">❓ 常见问题</view>
    <view class="faq-list">
      <view 
        class="faq-item {{item.open ? 'open' : ''}}" 
        wx:for="{{faqList}}" 
        wx:key="question"
        bindtap="toggleFaq"
        data-index="{{index}}"
      >
        <view class="faq-question">Q: {{item.question}}</view>
        <view class="faq-answer">A: {{item.answer}}</view>
        <view class="faq-arrow">{{item.open ? '▲' : '▼'}}</view>
      </view>
    </view>
  </view>
</view>
