/* pages/guide/guide.wxss */
.guide-header {
  text-align: center;
  padding: 40rpx 0;
}

.guide-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.guide-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.guide-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
}

.condition-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.condition-item:last-child {
  margin-bottom: 0;
}

.check-icon {
  color: #10B981;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.condition-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.material-item {
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 0;
  line-height: 1.6;
}

.office-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.office-item {
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}

.office-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.office-address {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.office-phone {
  font-size: 24rpx;
  color: #10B981;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.faq-item {
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  position: relative;
  cursor: pointer;
}

.faq-question {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 0;
  padding-right: 40rpx;
  line-height: 1.5;
}

.faq-answer {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e5e7eb;
  display: none;
}

.faq-item.open .faq-answer {
  display: block;
}

.faq-arrow {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  font-size: 24rpx;
  color: #999;
}
