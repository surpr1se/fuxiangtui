.user-card{background:linear-gradient(135deg,#FF7B6B 0%,#FF6B6B 100%);border-radius:24rpx;padding:32rpx;margin-bottom:24rpx}.user-info-row{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid rgba(255,255,255,.2)}.user-info-row:last-child{border-bottom:none}.label{color:rgba(255,255,255,.85);font-size:26rpx}.value{color:#fff;font-size:28rpx;font-weight:600}.highlight{font-size:30rpx}.pdf-info-card{background:#F0FDF4;border:1rpx solid #BBF7D0;border-radius:18rpx;padding:20rpx 24rpx;margin-bottom:20rpx;display:flex;gap:16rpx;align-items:center}.pdf-ok{width:36rpx;height:36rpx;border-radius:50%;background:#10B981;color:#fff;text-align:center;line-height:36rpx;font-weight:700}.pdf-title{font-size:26rpx;font-weight:700;color:#166534}.pdf-desc{font-size:22rpx;color:#666;margin-top:4rpx}.summary-card{background:linear-gradient(135deg,#FF7B6B 0%,#FF6B6B 100%);border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;color:#fff}.summary-title{font-size:24rpx;opacity:.9}.summary-number{font-size:44rpx;font-weight:700;margin-top:8rpx}.summary-unit{font-size:22rpx;opacity:.8}.summary-row{display:flex;margin-top:24rpx}.summary-item{flex:1;text-align:center}.summary-label{font-size:22rpx;opacity:.75}.summary-value{font-size:24rpx;font-weight:600;margin-top:6rpx}.detail-header{display:flex;justify-content:space-between;align-items:center;font-size:28rpx;font-weight:700;color:#333;margin-bottom:12rpx}.count{font-size:22rpx;color:#999;font-weight:400}.year-block{border-bottom:1rpx solid #f2f2f2}.year-block:last-child{border-bottom:none}.year-row{display:flex;align-items:center;padding:20rpx 0;gap:12rpx}.row-left{flex:1}.row-year{font-size:30rpx;font-weight:700;color:#333}.modified-tag{background:#FEF3C7;color:#D97706;font-size:20rpx;padding:3rpx 8rpx;border-radius:6rpx;margin-left:8rpx}.row-base{font-size:23rpx;color:#999;margin-top:6rpx}.row-right{text-align:right}.row-money{font-size:28rpx;font-weight:700;color:#FF6B6B}.row-month{font-size:22rpx;color:#999;margin-top:4rpx}.edit-btn{margin:0;width:92rpx;height:52rpx;line-height:52rpx;border-radius:12rpx;background:#f5f5f5;color:#666;font-size:22rpx;padding:0}.month-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;background:#F9FAFB;border-radius:14rpx;padding:16rpx;margin-bottom:16rpx}.month-cell{background:#fff;border-radius:8rpx;text-align:center;padding:10rpx 4rpx}.month-name{font-size:20rpx;color:#999}.month-base{font-size:22rpx;font-weight:600;color:#333;margin-top:4rpx}.modal-mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.45);z-index:999;display:flex;align-items:center;justify-content:center;padding:32rpx}.edit-modal{background:#fff;border-radius:24rpx;padding:28rpx;width:100%;max-height:80vh;overflow:auto}.modal-title{text-align:center;font-size:32rpx;font-weight:700;color:#333;margin-bottom:24rpx}.edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.edit-month{display:flex;align-items:center;gap:10rpx;background:#F9FAFB;border-radius:12rpx;padding:12rpx;font-size:24rpx;color:#666}.edit-month input{flex:1;background:#fff;border-radius:8rpx;height:56rpx;padding:0 10rpx;text-align:right}.modal-actions{display:flex;gap:16rpx;margin-top:28rpx}.modal-actions button{flex:1}
