<view class="container">
  <view class="user-card">
    <view class="user-info-row"><text class="label">姓名</text><text class="value">{{personalInfo.name || '-'}}</text></view>
    <view class="user-info-row"><text class="label">社会保障号</text><text class="value">{{idCardMasked}}</text></view>
    <view class="user-info-row"><text class="label">累计缴费月数</text><text class="value highlight">{{summary.totalMonths}}个月（{{summary.totalYears}}年）</text></view>
    <view class="user-info-row"><text class="label">个人账户累计</text><text class="value">{{summary.personalTotalText}}</text></view>
  </view>

  <view class="pdf-info-card" wx:if="{{pdfInfo}}">
    <view class="pdf-ok">✓</view>
    <view><view class="pdf-title">PDF解析成功</view><view class="pdf-desc">{{pdfInfo.fileName}} · 提取到 {{summary.totalMonths}} 条缴费记录</view></view>
  </view>

  <view class="summary-card">
    <view class="summary-title">累计缴费总额</view>
    <view class="summary-number">{{summary.personalTotalText}}</view>
    <view class="summary-unit">个人缴费部分（缴费基数 × 8%）</view>
    <view class="summary-row">
      <view class="summary-item"><view class="summary-label">缴费月数</view><view class="summary-value">{{summary.totalMonths}}个月</view></view>
      <view class="summary-item"><view class="summary-label">平均基数</view><view class="summary-value">{{summary.avgPaymentBaseText}}</view></view>
      <view class="summary-item"><view class="summary-label">平均指数</view><view class="summary-value">{{summary.avgPaymentIndex}}</view></view>
    </view>
  </view>

  <view class="card">
    <view class="detail-header"><text>📋 缴费明细</text><text class="count">按年份汇总</text></view>
    <view wx:for="{{yearGroups}}" wx:key="year" class="year-block">
      <view class="year-row" bindtap="toggleYear" data-year="{{item.year}}">
        <view class="row-left">
          <view class="row-year">{{item.year}}年 <text wx:if="{{item.modified}}" class="modified-tag">已修改</text></view>
          <view class="row-base">缴费基数：{{item.avgBaseText}}</view>
        </view>
        <view class="row-right">
          <view class="row-money">{{item.personalAmountText}}</view>
          <view class="row-month">{{item.months}}个月</view>
        </view>
        <button class="edit-btn" catchtap="openEdit" data-year="{{item.year}}">编辑</button>
      </view>
      <view class="month-grid" wx:if="{{item.expanded}}">
        <view class="month-cell" wx:for="{{item.items}}" wx:for-item="month" wx:key="yearMonth">
          <view class="month-name">{{month.monthText}}</view>
          <view class="month-base">{{month.paymentBaseText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="btn-group">
    <button class="btn-secondary" bindtap="reUpload">重新上传</button>
    <button class="btn-primary" bindtap="goNext">下一步：补充信息</button>
  </view>

  <view class="modal-mask" wx:if="{{editVisible}}" catchtap="closeEdit">
    <view class="edit-modal" catchtap="noop">
      <view class="modal-title">编辑{{editYear}}年缴费基数</view>
      <view class="edit-grid">
        <view class="edit-month" wx:for="{{editItems}}" wx:key="yearMonth">
          <text>{{item.monthText}}</text>
          <input type="digit" value="{{item.inputValue}}" data-index="{{index}}" bindinput="onMonthBaseInput" />
        </view>
      </view>
      <view class="modal-actions"><button class="btn-secondary" bindtap="closeEdit">取消</button><button class="btn-primary" bindtap="saveEdit">保存</button></view>
    </view>
  </view>
</view>
