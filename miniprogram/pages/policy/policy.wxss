.policy-page{min-height:100vh;background:#f7f7f7;padding:24rpx 24rpx 36rpx;box-sizing:border-box}.policy-title-row{display:flex;align-items:center;gap:14rpx;margin:0 0 28rpx}.policy-title-icon{font-size:40rpx;line-height:1}.policy-title{font-size:36rpx;font-weight:800;color:#333}.policy-card{background:#fff;border-radius:24rpx;padding:30rpx;margin-bottom:24rpx;box-shadow:0 6rpx 24rpx rgba(0,0,0,.04)}.policy-section-title{font-size:30rpx;font-weight:800;color:#FF6B6B;margin-bottom:22rpx}.policy-line{font-size:28rpx;color:#666;line-height:1.85;margin-bottom:8rpx}.formula-box{background:#FFF8F0;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx;text-align:center;color:#333;font-size:27rpx;font-weight:700;line-height:1.8}.policy-formula-title{font-size:30rpx;font-weight:800;color:#FF6B6B;line-height:1.7}.notice-box{background:#FFF8F0;border-radius:16rpx;padding:22rpx;color:#D97706;font-size:26rpx;line-height:1.75;margin-top:18rpx}.row-box{background:#FFF8F0;border-radius:16rpx;padding:16rpx 22rpx}.policy-row{display:flex;align-items:center;justify-content:space-between;padding:14rpx 0;border-bottom:1rpx solid #FFE8DA}.policy-row:last-child{border-bottom:0}.row-label{font-size:26rpx;color:#666}.row-value{font-size:28rpx;font-weight:800;color:#333;text-align:right;max-width:68%}.row-value.highlight{color:#FF6B6B}.policy-table{border:1rpx solid #FFE0D0;border-radius:14rpx;overflow:hidden}.table-row{display:flex}.table-head{background:#FFF8F0}.table-cell{flex:1;min-height:70rpx;padding:14rpx 8rpx;box-sizing:border-box;border-right:1rpx solid #FFE0D0;border-bottom:1rpx solid #FFE0D0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:25rpx;color:#333}.table-cell:first-child{justify-content:flex-start;color:#666}.table-row:last-child .table-cell{border-bottom:0}.table-cell:last-child{border-right:0}.grid-subtitle{font-size:26rpx;font-weight:700;color:#333;margin:10rpx 0 16rpx}.month-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.month-card{background:#F8FAFC;border-radius:14rpx;padding:18rpx;text-align:center}.month-card.wide{grid-column:span 2}.month-label{font-size:24rpx;color:#666}.month-value{font-size:32rpx;font-weight:900;color:#FF6B6B;margin-top:6rpx}.concept-item{padding:20rpx 0;border-bottom:1rpx solid #F5F5F5}.concept-item:last-child{border-bottom:0;padding-bottom:0}.concept-title{font-size:28rpx;font-weight:800;color:#333;margin-bottom:8rpx}.concept-desc{font-size:25rpx;color:#666;line-height:1.65}.doc-item{background:#F8FAFC;border-radius:16rpx;padding:20rpx;margin-bottom:14rpx}.doc-item:last-child{margin-bottom:0}.doc-title{font-size:27rpx;font-weight:800;color:#333}.doc-desc{font-size:24rpx;color:#666;line-height:1.6;margin-top:8rpx}.chip-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14rpx}.chip{background:#FFF8F0;border-radius:14rpx;padding:18rpx 8rpx;text-align:center;color:#FF6B6B;font-size:25rpx;font-weight:800}.policy-footer-note{font-size:23rpx;color:#999;text-align:center;margin-top:18rpx;line-height:1.6}.timeline{position:relative;padding-left:42rpx}.timeline:before{content:'';position:absolute;left:15rpx;top:8rpx;bottom:8rpx;width:4rpx;background:#E5E7EB}.timeline-item{position:relative;margin-bottom:30rpx}.timeline-item:last-child{margin-bottom:0}.timeline-dot{position:absolute;left:-42rpx;top:2rpx;width:34rpx;height:34rpx;border-radius:50%;background:#10B981;color:#fff;font-size:20rpx;font-weight:800;display:flex;align-items:center;justify-content:center}.timeline-title{font-size:28rpx;font-weight:800;color:#333;margin-bottom:8rpx}.timeline-desc{font-size:24rpx;color:#666;line-height:1.65}.agency-item{padding:20rpx 0;border-bottom:1rpx solid #F3F4F6}.agency-item:last-child{border-bottom:0}.agency-name{font-size:27rpx;font-weight:700;color:#333}.agency-address{font-size:23rpx;color:#999;margin-top:6rpx}.faq-item{margin-bottom:22rpx}.faq-item:last-child{margin-bottom:0}.faq-q{font-size:26rpx;font-weight:800;color:#333;margin-bottom:8rpx}.faq-a{font-size:24rpx