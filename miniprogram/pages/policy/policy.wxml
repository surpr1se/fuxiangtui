<view class="policy-page">
  <view class="policy-title-row">
    <text class="policy-title-icon">{{policy.icon}}</text>
    <text class="policy-title">{{policy.title}}</text>
  </view>

  <view wx:for="{{policy.sections}}" wx:key="index" class="policy-card">
    <view wx:if="{{item.title}}" class="policy-section-title">{{item.title}}</view>

    <block wx:if="{{!item.type || item.type === 'formula'}}">
      <view wx:if="{{item.formula}}" class="formula-box">{{item.formula}}</view>
      <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="index" class="policy-line">{{line}}</view>
      <view wx:if="{{item.notice}}" class="notice-box">{{item.notice}}</view>
    </block>

    <block wx:elif="{{item.type === 'formulaTitle'}}">
      <view class="policy-formula-title">{{item.title}}</view>
    </block>

    <block wx:elif="{{item.type === 'rows'}}">
      <view class="row-box">
        <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="label" class="policy-row">
          <text class="row-label">{{row.label}}</text>
          <text class="row-value {{row.highlight ? 'highlight' : ''}}">{{row.value}}</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{item.type === 'table'}}">
      <view class="policy-table">
        <view class="table-row table-head">
          <text wx:for="{{item.headers}}" wx:for-item="h" wx:key="index" class="table-cell">{{h}}</text>
        </view>
        <view wx:for="{{item.rows}}" wx:for-item="tr" wx:key="index" class="table-row">
          <text wx:for="{{tr}}" wx:for-item="td" wx:key="index" class="table-cell">{{td}}</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{item.type === 'formulaGrid'}}">
      <view class="formula-box">{{item.formula}}</view>
      <view class="grid-subtitle">{{item.subtitle}}</view>
      <view class="month-grid">
        <view wx:for="{{item.cards}}" wx:for-item="card" wx:key="label" class="month-card {{card.wide ? 'wide' : ''}}">
          <view class="month-label">{{card.label}}</view>
          <view class="month-value">{{card.value}}</view>
        </view>
      </view>
    </block>

    <block wx:elif="{{item.type === 'concepts'}}">
      <view wx:for="{{item.concepts}}" wx:for-item="concept" wx:key="title" class="concept-item">
        <view class="concept-title">{{concept.title}}</view>
        <view class="concept-desc">{{concept.desc}}</view>
      </view>
    </block>

    <block wx:elif="{{item.type === 'docs'}}">
      <view wx:for="{{item.docs}}" wx:for-item="doc" wx:key="title" class="doc-item">
        <view class="doc-title">{{doc.title}}</view>
        <view class="doc-desc">{{doc.desc}}</view>
      </view>
    </block>

    <block wx:elif="{{item.type === 'chips'}}">
      <view class="chip-grid">
        <view wx:for="{{item.chips}}" wx:for-item="chip" wx:key="index" class="chip">{{chip}}</view>
      </view>
      <view class="policy-footer-note">{{item.footer}}</view>
    </block>

    <block wx:elif="{{item.type === 'timeline'}}">
      <view class="timeline">
        <view wx:for="{{item.steps}}" wx:for-item="step" wx:key="title" class="timeline-item">
          <view class="timeline-dot">{{step.no}}</view>
          <view class="timeline-content">
            <view class="timeline-title">{{step.title}}</view>
            <view class="timeline-desc">{{step.desc}}</view>
          </view>
        </view>
      </view>
    </block>

    <block wx:elif="{{item.type === 'agencies'}}">
      <view wx:for="{{item.agencies}}" wx:for-item="agency" wx:key="name" class="agency-item">
        <view class="agency-name">{{agency.name}}</view>
        <view wx:if="{{agency.address}}" class="agency-address">{{agency.address}}</view>
      </view>
    </block>

    <block wx:elif="{{item.type === 'faqs'}}">
      <view wx:for="{{item.faqs}}" wx:for-item="faq" wx:key="q" class="faq-item">
        <view class="faq-q">{{faq.q}}</view>
        <view class="faq-a">{{faq.a}}</view>
      </view>
    </block>

    <block wx:elif="{{item.type === 'service'}}">
      <view class="service-btn">{{item.button}}</view>
      <view class="service-desc">{{item.desc}}</view>
    </block>
  </view>

  <view wx:if="{{policy.footer}}" class="page-footer">{{policy.footer}}</view>
</view>
