<view class="page profile-page">
  <view class="hero profile-hero">
    <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="选择微信头像">
      <image wx:if="{{avatarUrl}}" class="profile-avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="profile-avatar-placeholder">👤</view>
    </button>
    <input class="profile-name" type="nickname" value="{{userName}}" placeholder="点击填写昵称" bindblur="onNicknameBlur" bindconfirm="onNicknameConfirm" />
    <view wx:if="{{!profileCompleted}}" class="profile-desc">点击头像选择微信头像，点击昵称填写微信昵称</view>
  </view>

  <view class="card profile-stats-card">
    <view class="stats-item">
      <view class="stats-value">{{calcCount}}</view>
      <view class="stats-label">测算次数</view>
    </view>
    <view class="stats-line"></view>
    <view class="stats-item">
      <view class="stats-value">{{avgPension}}</view>
      <view class="stats-label">平均待遇</view>
    </view>
    <view class="stats-line"></view>
    <view class="stats-item">
      <view class="stats-value">{{paymentMonths}}</view>
      <view class="stats-label">累计缴费月</view>
    </view>
  </view>

  <view class="card profile-record-card" bindtap="history">
    <view class="profile-card-header">
      <view class="profile-card-title">我的计算记录</view>
      <view class="profile-card-link">查看全部 ></view>
    </view>
    <view wx:if="{{!latest}}" class="profile-empty">暂无测算记录</view>
    <view wx:else class="latest-record">
      <view class="latest-title">最近一次测算结果</view>
      <view class="latest-desc">点击查看测算详情</view>
    </view>
  </view>

  <view class="profile-section">
    <view class="profile-section-title-row">
      <text class="profile-section-icon">💻</text>
      <text class="profile-section-title">政策说明</text>
    </view>
    <view class="profile-list">
      <view class="profile-list-item" bindtap="policyDetail" data-policy="pension">
        <view class="profile-list-left"><text class="profile-list-icon">📄</text><text class="profile-list-text">养老保险政策解读</text></view>
        <text class="profile-arrow">></text>
      </view>
      <view class="profile-list-item" bindtap="policyDetail" data-policy="formula">
        <view class="profile-list-left"><text class="profile-list-icon">📊</text><text class="profile-list-text">待遇计算公式说明</text></view>
        <text class="profile-arrow">></text>
      </view>
      <view class="profile-list-item" bindtap="policyDetail" data-policy="fujian">
        <view class="profile-list-left"><text class="profile-list-icon">📍</text><text class="profile-list-text">福建省社保政策</text></view>
        <text class="profile-arrow">></text>
      </view>
      <view class="profile-list-item last" bindtap="policyDetail" data-policy="retire">
        <view class="profile-list-left"><text class="profile-list-icon">🪪</text><text class="profile-list-text">退休手续办理指南</text></view>
        <text class="profile-arrow">></text>
      </view>
    </view>
  </view>

  <view class="profile-section">
    <view class="profile-section-title-row">
      <text class="profile-section-icon">☀️</text>
      <text class="profile-section-title">其他</text>
    </view>
    <view class="profile-list">
      <view class="profile-list-item" bindtap="policyDetail" data-policy="agreement">
        <view class="profile-list-left"><text class="profile-list-icon">📝</text><text class="profile-list-text">用户协议</text></view>
        <text class="profile-arrow">></text>
      </view>
      <view class="profile-list-item" bindtap="policyDetail" data-policy="privacy">
        <view class="profile-list-left"><text class="profile-list-icon">🔒</text><text class="profile-list-text">隐私政策</text></view>
        <text class="profile-arrow">></text>
      </view>
      <view class="profile-list-item logout-item last" bindtap="logout">
        <view class="profile-list-left"><text class="profile-list-icon logout-icon">↪</text><text class="profile-list-text logout-text">退出登录</text></view>
        <text class="profile-arrow">></text>
      </view>
    </view>
  </view>

  <view class="version-text">福享退 v1.0.0</view>
</view>
