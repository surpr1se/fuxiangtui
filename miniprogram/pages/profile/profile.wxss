.profile-hero{background:linear-gradient(135deg,#FF7B6B,#FF6B6B);border-radius:30rpx;padding:38rpx;text-align:center;color:#fff}.avatar{width:110rpx;height:110rpx;line-height:110rpx;border-radius:50%;background:#fff;margin:0 auto;color:#FF6B6B;font-size:56rpx;overflow:hidden}.avatar-img{width:110rpx;height:110rpx}.name{font-size:32rpx;font-weight:800;margin-top:18rpx}.login-hint{font-size:22rpx;opacity:0.7;margin-top:8rpx}.stat{display:flex;background:linear-gradient(135deg,#FF7B6B,#FF6B6B);color:#fff;border-radius:22rpx;padding:24rpx;margin:24rpx 0}.stat>view{flex:1;text-align:center}.num{font-size:32rpx;font-weight:900;margin-bottom:8rpx}.card{background:#fff;border-radius:22rpx;padding:24rpx;margin-bottom:20rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04)}.row{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #f1f1f1}.row:last-child{border-bottom:none}.money{color:#FF6B6B;font-weight:600}.empty{color:#ccc;font-size:24rpx;padding:12rpx 24rpx}
