.profile-hero{background:linear-gradient(135deg,#FF7B6B,#FF6B6B);border-radius:30rpx;padding:38rpx;text-align:center;color:#fff}.avatar{width:110rpx;height:110rpx;line-height:110rpx;border-radius:50%;background:#fff;margin:0 auto;color:#FF6B6B;font-size:56rpx;overflow:hidden}.avatar-img{width:110rpx;height:110rpx}.name{font-size:32rpx;font-weight:800;margin-top:18rpx}.login-hint{font-size:22rpx;opacity:0.82;margin-top:8rpx}.profile-card{background:#fff;border-radius:24rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04)}.profile-title{font-size:30rpx;font-weight:800;color:#222;margin-bottom:8rpx}.profile-desc{font-size:24rpx;color:#888;line-height:1.5;margin-bottom:24rpx}.profile-form{display:flex;align-items:center;gap:22rpx}.avatar-picker{width:112rpx;height:112rpx;line-height:112rpx;margin:0;padding:0;border-radius:50%;background:#fff5f5;color:#FF6B6B;font-size:22rpx;overflow:hidden}.avatar-picker::after{border:none}.avatar-picker-img{width:112rpx;height:112rpx}.nickname-input{flex:1;height:88rpx;line-height:88rpx;padding:0 24rpx;border-radius:18rpx;background:#f8f8f8;color:#222;font-size:28rpx}.save-profile-btn{height:88rpx;line-height:88rpx;margin-top:24rpx;border-radius:44rpx;background:linear-gradient(135deg,#FF7B6B,#FF6B6B);color:#fff;font-size:30rpx;font-weight:700}.save-profile-btn::after{border:none}.stat{display:flex;background:linear-gradient(135deg,#FF7B6B,#FF6B6B);color:#fff;border-radius:22rpx;padding:24rpx;margin:24rpx 0}.stat>view{flex:1;text-align:center}.num{font-size:32rpx;font-weight:900;margin-bottom:8rpx}.card{background:#fff;border-radius:22rpx;padding:24rpx;margin-bottom:20rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04)}.row{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #f1f1f1}.row:last-child{border-bottom:none}.money{color:#FF6B6B;font-weight:600}.empty{color:#ccc;font-size:24rpx;padding:12rpx 24rpx}
