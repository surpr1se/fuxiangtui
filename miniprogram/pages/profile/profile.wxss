.profile-page{min-height:100vh;background:#f7f7f7;padding-bottom:32rpx;color:#333}.profile-header{margin:0 0 40rpx;background:linear-gradient(135deg,#FF6B6B 0%,#FF8E53 100%);padding:56rpx 32rpx 44rpx;text-align:center;color:#fff}.avatar-button{width:128rpx!important;height:128rpx!important;line-height:normal!important;margin:0 auto 24rpx!important;padding:0!important;border-radius:50%!important;background:#fff!important;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;box-shadow:0 8rpx 24rpx rgba(0,0,0,.10)}.avatar-button::after{border:none!important}.profile-avatar{width:128rpx;height:128rpx;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;color:#666;font-size:56rpx}.profile-avatar-img{width:128rpx;height:128rpx;display:block}.profile-avatar-empty{background:#fff}.profile-name{display:block;width:520rpx;height:44rpx;line-height:44rpx;margin:0 auto;color:#fff;font-size:36rpx;font-weight:600;text-align:center}.profile-name::placeholder{color:rgba(255,255,255,.82)}.profile-tip{display:inline-flex;align-items:center;justify-content:center;min-height:36rpx;margin-top:12rpx;padding:0 18rpx;border-radius:18rpx;background:rgba(255,255,255,.16);color:rgba(255,255,255,.92);font-size:22rpx}.summary-card{margin:-16rpx 32rpx 32rpx;padding:32rpx 0;border-radius:24rpx;background:linear-gradient(135deg,#FF7B6B 0%,#FF6B6B 100%);color:#fff;display:flex;align-items:center;box-shadow:0 8rpx 22rpx rgba(255,107,107,.20)}.summary-item{flex:1;text-align:center;min-width:0}.summary-value{font-size:44rpx;font-weight:700;line-height:1.15;white-space:nowrap}.summary-label{margin-top:8rpx;font-size:22rpx;opacity:.82}.summary-divider{width:1rpx;height:56rpx;background:rgba(255,255,255,.24)}.section{padding:0 32rpx;margin-bottom:32rpx}.section-title-row{height:44rpx;display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.section-title-row.static{justify-content:flex-start}.section-title-left{display:flex;align-items:center;min-width:0}.section-icon{width:36rpx;height:36rpx;margin-right:12rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;line-height:1}.section-title{font-size:30rpx;font-weight:600;color:#333}.section-link{font-size:24rpx;color:#FF6B6B}.history-card{min-height:96rpx;padding:24rpx;border-radius:20rpx;background:#fff;box-shadow:0 4rpx 16rpx rgba(0,0,0,.05);display:flex;align-items:center;justify-content:center}.empty{color:#999;font-size:26rpx}.history-content{width:100%}.history-title{font-size:28rpx;font-weight:600;color:#333}.history-subtitle{margin-top:8rpx;font-size:24rpx;color:#999}.menu-list{background:#fff;border-radius:20rpx;overflow:hidden;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04)}.menu-list-item{min-height:104rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f5f5f5}.menu-list-item.last{border-bottom:none}.menu-left{display:flex;align-items:center;min-width:0}.menu-icon{width:56rpx;height:56rpx;border-radius:16rpx;margin-right:20rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:28rpx;line-height:1;flex-shrink:0}.gradient-red{background:linear-gradient(135deg,#FF6B6B 0%,#FF8E53 100%)}.gradient-blue{background:linear-gradient(135deg,#4FACFE 0%,#0072FF 100%)}.gradient-green{background:linear-gradient(135deg,#43E97B 0%,#38F9D7 100%)}.menu-text{font-size:28rpx;color:#333;font-weight:500}.menu-arrow{font-size:28rpx;color:#bbb}.menu-extra{font-size:26rpx;color:#999}
