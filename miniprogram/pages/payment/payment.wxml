<view class="page">
  <view class="hero">
    <view class="hero-title">缴费明细</view>
    <view class="hero-desc">{{heroDesc}}</view>
  </view>
  <view class="summary-card">
    <view><text>累计缴费</text><text>{{summary.totalYears}}年</text></view>
    <view><text>个人账户</text><text>{{summary.personalTotalText}}</text></view>
    <view><text>平均基数</text><text>{{summary.avgBaseText}}</text></view>
  </view>
  <view class="year-card" wx:for="{{groups}}" wx:key="year">
    <view class="year-head" bindtap="toggle" data-year="{{item.year}}">
      <view><text class="year">{{item.year}}年</text><text class="muted">{{item.months}}个月 · 月均{{item.avgBaseText}}</text></view>
      <view><text class="money">{{item.personalAmountText}}</text><button size="mini" catchtap="edit" data-year="{{item.year}}">编辑</button></view>
    </view>
    <view wx:if="{{item.expanded}}" class="month-grid">
      <view class="month" wx:for="{{item.items}}" wx:for-item="m" wx:key="yearMonth"><text>{{m.monthText}}</text><text>{{m.paymentBaseText}}</text></view>
    </view>
  </view>
  <view class="btn-row"><button class="btn-secondary" bindtap="back">返回</button><button class="btn-primary" bindtap="next">下一步</button></view>
  <view wx:if="{{editVisible}}" class="modal-mask" catchtap="close">
    <view class="modal" catchtap="noop">
      <view class="modal-title">编辑 {{editYear}} 年缴费基数</view>
      <view class="edit-row" wx:for="{{editItems}}" wx:key="yearMonth">
        <text>{{item.monthText}}</text><input type="digit" value="{{item.inputValue}}" data-index="{{index}}" bindinput="input" />
      </view>
      <view class="btn-row"><button class="btn-secondary" bindtap="close">取消</button><button class="btn-primary" bindtap="save">保存</button></view>
    </view>
  </view>
</view>
