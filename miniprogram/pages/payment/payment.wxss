@import "../../styles/calc-flow.wxss";
.payment-summary-card{display:flex;align-items:center;padding:30rpx 0}.summary-item{flex:1;text-align:center;min-width:0}.summary-value{font-size:38rpx;font-weight:900;color:#FF6B6B;line-height:1.2}.summary-value.small{font-size:28rpx}.summary-label{font-size:23rpx;color:#999;margin-top:8rpx}.summary-line{width:1rpx;height:58rpx;background:#f0f0f0}.payment-tip{background:#F8FAFC}.flow-tip.compact{font-size:26rpx;margin:14rpx 0}.year-card{background:#fff;border-radius:24rpx;margin-bottom:20rpx;box-shadow:0 6rpx 24rpx rgba(0,0,0,.05);overflow:hidden}.year-head{display:flex;align-items:center;justify-content:space-between;padding:26rpx 28rpx}.year-left{min-width:0}.year-title{font-size:31rpx;font-weight:900;color:#222}.year-desc{font-size:24rpx;color:#999;margin-top:8rpx}.year-right{text-align:right;margin-left:18rpx;flex-shrink:0}.year-money{font-size:26rpx;color:#FF6B6B;font-weight:800;margin-bottom:10rpx}.year-edit-btn{width:92rpx!important;height:52rpx!important;line-height:52rpx!important;margin:0!important;padding:0!important;border-radius:26rpx!important;background:#FFF1F2!important;color:#FF6B6B!important;font-size:22rpx!important}.year-edit-btn::after{border:none!important}.month-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;background:#F9FAFB;padding:18rpx;margin:0 20rpx 22rpx;border-radius:18rpx}.month-cell{text-align:center;background:#fff;border-radius:12rpx;padding:12rpx 4rpx}.month-name{font-size:22rpx;color:#999}.month-base{font-size:22rpx;color:#333;font-weight:700;margin-top:6rpx}.payment-modal{padding-bottom:30rpx}.edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.edit-cell{display:flex;align-items:center;gap:10rpx;background:#F9FAFB;border-radius:14rpx;padding:12rpx;font-size:24rpx}.edit-cell input{flex:1;background:#fff;border-radius:10rpx;height:58rpx;text-align:right;padding:0 8rpx;font-size:24rpx;box-sizing:border-box}
