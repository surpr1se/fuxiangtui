.year{border-bottom:1rpx solid #f3f3f3}.year-row{display:flex;align-items:center;gap:14rpx;padding:20rpx 0}.year-title{font-size:29rpx;font-weight:800}.year-right{text-align:right;flex:1}.year button{width:92rpx;height:52rpx;line-height:52rpx;border-radius:12rpx;background:#f5f5f5;color:#666;font-size:22rpx;padding:0}.month-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;background:#F9FAFB;border-radius:16rpx;padding:16rpx;margin-bottom:18rpx}.month{text-align:center;background:#fff;border-radius:10rpx;padding:10rpx 4rpx;font-size:22rpx}.edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.edit-cell{display:flex;align-items:center;gap:10rpx;background:#F9FAFB;border-radius:12rpx;padding:12rpx}.edit-cell input{flex:1;background:#fff;border-radius:8rpx;height:58rpx;text-align:right;padding:0 8rpx}
