<view class="flow-page calculate-page">
  <view class="flow-steps calculate-steps">
    <view class="flow-step active"><view class="flow-step-dot">1</view><view class="flow-step-text">上传PDF</view></view>
    <view class="flow-line"></view>
    <view class="flow-step"><view class="flow-step-dot">2</view><view class="flow-step-text">核对明细</view></view>
    <view class="flow-line"></view>
    <view class="flow-step"><view class="flow-step-dot">3</view><view class="flow-step-text">信息补全</view></view>
    <view class="flow-line"></view>
    <view class="flow-step"><view class="flow-step-dot">4</view><view class="flow-step-text">计算结果</view></view>
  </view>

  <view wx:if="{{!hasLogged}}" class="calc-login-gate">
    <view class="calc-login-icon">🔐</view>
    <view class="calc-login-title">登录后开始测算</view>
    <view class="calc-login-desc">登录后可上传 PDF、保存解析记录和查看历史测算结果</view>
    <button class="flow-primary-btn calc-login-btn" bindtap="login">微信登录</button>
  </view>

  <block wx:else>
  <view class="pdf-upload-card" bindtap="chooseFile">
    <view class="pdf-upload-icon">📤</view>
    <view class="pdf-upload-title">{{fileInfo ? fileInfo.name : '点击上传PDF文件'}}</view>
    <view class="pdf-upload-desc">{{fileInfo ? fileInfo.size : '仅支持PDF格式，文件不超过20MB'}}</view>
  </view>

  <view class="flow-card selected-file-card" wx:if="{{fileInfo}}">
    <view class="selected-file-head">
      <view class="flow-section-title selected-file-title"><text class="flow-section-title-icon">📄</text>已选择文件</view>
      <button class="clear-file-btn" bindtap="clearFile">清除</button>
    </view>
    <view class="flow-row"><text class="flow-label">文件名</text><text class="flow-value">{{fileInfo.name}}</text></view>
    <view class="flow-row"><text class="flow-label">大小</text><text class="flow-value">{{fileInfo.size}}</text></view>
  </view>

  <view class="upload-progress" wx:if="{{uploading}}">
    <view class="upload-progress-bar" style="width:{{progress}}%"></view>
  </view>

  <button class="flow-primary-btn upload-action" wx:if="{{fileInfo}}" loading="{{uploading}}" bindtap="startUpload">开始解析</button>
  <view class="demo-entry" bindtap="useDemo">没有PDF？使用示例数据体验</view>

  <view class="flow-tip-card">
    <view class="flow-tip-title"><text>💡</text>上传提示</view>
    <view class="flow-tip"><text class="flow-check">✓</text><text>请使用“福建社保”微信公众号下载的完整缴费明细，功能路径为：业务办理-服务大厅-个人缴费信息</text></view>
    <view class="flow-tip"><text class="flow-check">✓</text><text>系统会自动识别并提取缴费数据，如识别不准，可在下一步手动修改</text></view>
    <view class="flow-tip"><text class="flow-check">✓</text><text>PDF文件需完整、未加密，大小不超过20MB</text></view>
  </view>
  </block>
</view>
