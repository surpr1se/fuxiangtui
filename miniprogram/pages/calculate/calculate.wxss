@import "../../styles/calc-flow.wxss";
.pdf-upload-card{border:3rpx dashed #FF8E53;background:#FFF8F0;border-radius:30rpx;padding:72rpx 30rpx;text-align:center;margin-bottom:32rpx}.pdf-upload-icon{width:120rpx;height:120rpx;border-radius:50%;margin:0 auto 28rpx;background:linear-gradient(135deg,#FF6B6B,#FF8E53);display:flex;align-items:center;justify-content:center;font-size:58rpx;color:#fff}.pdf-upload-title{font-size:32rpx;font-weight:800;color:#222;line-height:1.4;word-break:break-all}.pdf-upload-desc{font-size:26rpx;color:#999;margin-top:12rpx}.selected-file-card{margin-top:0}.upload-progress{height:14rpx;background:#eee;border-radius:999rpx;overflow:hidden;margin:18rpx 0 24rpx}.upload-progress-bar{height:100%;background:linear-gradient(90deg,#FF7B6B,#FF6B6B)}.upload-action{margin:0 0 12rpx}.demo-entry{text-align:center;color:#10B981;font-size:26rpx;padding:26rpx 0 34rpx}
