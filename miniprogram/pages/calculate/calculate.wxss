.upload-card{border:2rpx dashed #FF8E53;background:#FFF8F0;border-radius:30rpx;padding:80rpx 30rpx;text-align:center;margin-bottom:24rpx}.upload-icon{font-size:86rpx}.upload-title{font-size:32rpx;font-weight:800;color:#FF6B6B;margin-top:16rpx}.upload-desc{font-size:24rpx;color:#999;margin-top:8rpx}.progress{height:14rpx;background:#eee;border-radius:999rpx;overflow:hidden;margin:20rpx 0}.progress view{height:100%;background:linear-gradient(90deg,#FF7B6B,#FF6B6B)}.demo{text-align:center;color:#10B981;font-size:26rpx;padding:28rpx}.tip{font-size:25rpx;color:#78350F;line-height:1.8}
