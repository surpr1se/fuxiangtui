/* pages/index/index.wxss */
.logo-area {
  text-align: center;
  padding: 48rpx 0 40rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.3);
}

.logo-text {
  color: #fff;
  font-size: 72rpx;
  font-weight: 700;
}

.logo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.logo-desc {
  font-size: 28rpx;
  color: #999;
}

.menu-item {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.menu-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.menu-icon.primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
}

.menu-icon.blue {
  background: linear-gradient(135deg, #4FACFE 0%, #0072FF 100%);
}

.menu-icon.green {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
}

.menu-icon.purple {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: #999;
}
