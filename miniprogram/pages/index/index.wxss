.menu-card{background:#fff;border-radius:28rpx;padding:30rpx 20rpx;text-align:center;box-shadow:0 6rpx 24rpx rgba(0,0,0,.05);margin-bottom:18rpx}.menu-card.primary{background:linear-gradient(135deg,#FFF5F5,#fff)}.menu-icon{font-size:54rpx;margin-bottom:14rpx}.menu-title{font-size:29rpx;font-weight:800;color:#333}.menu-desc{font-size:22rpx;color:#999;margin-top:8rpx}.notice{margin-top:20rpx}.step{font-size:26rpx;color:#666;line-height:1.9}
