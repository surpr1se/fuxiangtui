<view class="page">
  <view class="hero"><view class="hero-title">福享退</view><view class="hero-desc">企业职工养老待遇测算<br/>上传缴费明细，自动测算退休待遇</view></view>
  <view class="grid2">
    <view class="menu-card primary" bindtap="goCalculate"><view class="menu-icon">📄</view><view class="menu-title">PDF上传测算</view><view class="menu-desc">导入缴费明细自动测算</view></view>
    <view class="menu-card" bindtap="goHistory"><view class="menu-icon">📊</view><view class="menu-title">历史记录</view><view class="menu-desc">查看过往测算结果</view></view>
    <view class="menu-card" bindtap="goProfile"><view class="menu-icon">👤</view><view class="menu-title">个人中心</view><view class="menu-desc">登录与数据统计</view></view>
    <view class="menu-card" bindtap="goPolicy"><view class="menu-icon">📚</view><view class="menu-title">政策说明</view><view class="menu-desc">退休政策与办理指南</view></view>
  </view>
  <view class="card notice"><view class="section-title">测算流程</view><view class="step">1. 上传缴费明细 PDF</view><view class="step">2. 核对并编辑缴费基数</view><view class="step">3. 补充退休身份和账户信息</view><view class="step">4. 生成养老金测算结果</view></view>
</view>
