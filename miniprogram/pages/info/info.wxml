<view class="page">
  <view class="hero"><view class="hero-title">补充信息</view><view class="hero-desc">系统已根据 PDF 自动返填，可手动调整</view></view>
  <view class="card">
    <view class="row"><text>姓名</text><text>{{personalInfo.name}}</text></view>
    <view class="row"><text>性别</text><text>{{genderText}}</text></view>
    <view class="row"><text>当前个人账户</text><text class="money">{{summary.personalTotalText}}</text></view>
  </view>
  <view class="card">
    <view wx:if="{{!hideIdentity}}" class="form-item">
      <text class="form-label">退休身份</text>
      <view class="grid2"><view class="option {{workerActive ? 'active' : ''}}" bindtap="setIdentity" data-v="工人">工人</view><view class="option {{cadreActive ? 'active' : ''}}" bindtap="setIdentity" data-v="干部">干部</view></view>
    </view>
    <view class="form-item"><text class="form-label">退休年月</text><input class="input" value="{{retireDate}}" bindinput="inputDate" /></view>
    <view class="form-item"><text class="form-label">退休年龄</text><input class="input" type="digit" value="{{retirementAge}}" bindinput="inputAge" /></view>
    <view wx:if="{{delayTip}}" class="delay">{{delayTip}}</view>
    <view class="form-item"><text class="form-label">视同缴费年限</text><input class="input" type="digit" value="{{visualYears}}" bindinput="inputVisual" /></view>
    <view class="form-item"><text class="form-label">个人账户累计金额</text><input class="input" type="digit" value="{{personalAccountAmount}}" bindinput="inputAccount" /></view>
    <view class="form-item"><text class="form-label">上年社平工资（月）</text><input class="input" type="digit" value="{{socialAvgWage}}" bindinput="inputWage" /></view>
  </view>
  <view class="card">
    <view class="section-title">未来缴费预测</view>
    <view class="grid2"><view class="option {{modeActive.real ? 'active' : ''}}" bindtap="mode" data-v="real">本人基数</view><view class="option {{modeActive.base60 ? 'active' : ''}}" bindtap="mode" data-v="base60">社平60%</view><view class="option {{modeActive.base100 ? 'active' : ''}}" bindtap="mode" data-v="base100">社平100%</view><view class="option {{modeActive.base300 ? 'active' : ''}}" bindtap="mode" data-v="base300">社平300%</view></view>
    <view class="row" wx:for="{{futureYears}}" wx:key="year"><text>{{item.year}}年 · {{item.months}}个月</text><text>{{item.amountText}}</text></view>
    <view class="row"><text>预计个人账户增加</text><text class="money">{{futureText}}</text></view>
  </view>
  <view class="btn-row"><button class="btn-secondary" bindtap="back">返回</button><button class="btn-primary" loading="{{calculating}}" bindtap="calculate">开始测算</button></view>
</view>
