<view class="page">
  <view class="result-hero"><view>预计月养老金</view><view class="result-money">{{pension.total}}</view><view>以上结果仅供参考</view></view>
  <view class="card"><view class="row"><text>退休年龄</text><text>{{basicInfo.retireAge}}岁</text></view><view class="row"><text>累计缴费年限</text><text>{{basicInfo.totalPaymentYears}}年</text></view><view class="row"><text>平均缴费指数</text><text>{{basicInfo.avgPaymentIndex}}</text></view><view class="row"><text>计发月数</text><text>{{basicInfo.calculateMonths}}个月</text></view></view>
  <view class="card"><view class="section-title">待遇明细构成</view><view class="row"><text>基础养老金</text><text>{{pension.basic}}</text></view><view class="row"><text>个人账户养老金</text><text>{{pension.personal}}</text></view><view class="row"><text>过渡性养老金</text><text>{{pension.transitional}}</text></view><view class="row"><text>合计</text><text class="money">{{pension.total}}</text></view></view>
  <view class="card"><view class="section-title">待遇调整预测</view><view class="row" wx:for="{{forecast}}" wx:key="year"><text>{{item.year}}年</text><text>{{item.amount}}</text></view></view>
  <view class="card"><view class="section-title">多方案对比</view><view class="scheme" wx:for="{{schemes}}" wx:key="name"><text>{{item.name}}</text><text class="money">{{item.amount}}</text></view></view>
  <view class="card"><view class="section-title" bindtap="toggleProcess">详细计算过程 {{processArrow}}</view><view wx:if="{{showProcess}}"><view class="process" wx:for="{{calculationProcess}}" wx:key="stepName"><view>{{item.stepName}}</view><view class="muted">{{item.formula}}</view><view class="money">{{item.result}}</view></view></view></view>
  <view class="btn-row"><button class="btn-secondary" bindtap="profile">查看历史</button><button class="btn-primary" bindtap="home">返回首页</button></view>
</view>
