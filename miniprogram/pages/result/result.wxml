<view class="container">
  <view class="result-header"><view class="result-icon">🎉</view><view class="result-title">测算完成</view><view class="result-subtitle">以下结果仅供参考，实际以社保经办机构核定为准</view></view>
  <view class="result-main-card"><view class="result-label">预计月养老金</view><view class="result-value">{{pension.totalMonthlyPensionText}}</view><view class="result-desc">含基础养老金 + 个人账户养老金 + 过渡性养老金</view></view>
  <view class="result-summary">
    <view class="summary-row"><view class="summary-item"><view class="summary-label">退休年龄</view><view class="summary-value">{{basicInfo.retireAge}}岁</view></view><view class="summary-item"><view class="summary-label">累计缴费年限</view><view class="summary-value">{{basicInfo.totalPaymentYears}}年</view></view></view>
    <view class="summary-row"><view class="summary-item"><view class="summary-label">平均缴费指数</view><view class="summary-value">{{basicInfo.avgPaymentIndex}}</view></view><view class="summary-item"><view class="summary-label">计发月数</view><view class="summary-value">{{basicInfo.calculateMonths}}个月</view></view></view>
  </view>
  <view class="card"><view class="detail-header" bindtap="toggleBreakdown"><text>📊 待遇明细构成</text><text>{{showBreakdown ? '▼' : '▶'}}</text></view><view wx:if="{{showBreakdown}}"><view class="breakdown-item"><text>基础养老金</text><text>{{pension.basicPensionText}}</text></view><view class="breakdown-item"><text>个人账户养老金</text><text>{{pension.personalAccountPensionText}}</text></view><view class="breakdown-item"><text>过渡性养老金</text><text>{{pension.transitionalPensionText}}</text></view><view class="breakdown-item total"><text>合计</text><text>{{pension.totalMonthlyPensionText}}</text></view></view></view>
  <view class="card"><view class="detail-header" bindtap="toggleProcess"><text>🔢 详细计算过程</text><text>{{showProcess ? '▼' : '▶'}}</text></view><view wx:if="{{showProcess}}"><view class="process-step" wx:for="{{result.calculationProcess}}" wx:key="stepName"><view class="process-step-title">{{item.stepName}}</view><view class="process-formula">{{item.formula}}</view><view class="process-result">结果：{{item.result}}</view></view></view></view>
  <view class="card"><view class="detail-header" bindtap="toggleForecast"><text>📈 待遇调整预测</text><text>{{showForecast ? '▼' : '▶'}}</text></view><view wx:if="{{showForecast}}"><view class="forecast-row" wx:for="{{adjustmentForecast}}" wx:key="year"><text>{{item.year}}年</text><text>{{item.amountText}}</text><text>{{item.rate}}</text></view></view></view>
  <view class="card"><view class="detail-header" bindtap="toggleCompare"><text>⚖️ 多方案对比</text><text>{{showCompare ? '▼' : '▶'}}</text></view><view wx:if="{{showCompare}}"><view class="compare-row header"><text>缴费档次</text><text>月待遇</text><text>回本年龄</text></view><view class="compare-row {{item.active ? 'active' : ''}}" wx:for="{{schemeCompare}}" wx:key="name"><text>{{item.name}}</text><text>{{item.amountText}}</text><text>{{item.breakEven}}</text></view></view></view>
  <view class="btn-group"><button class="btn-secondary" bindtap="saveResult">保存结果</button><button class="btn-primary" bindtap="goHome">返回首页</button></view>
</view>
