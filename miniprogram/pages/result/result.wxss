@import "../../styles/calc-flow.wxss";
.result-main-card{background:linear-gradient(135deg,#FF7B6B,#FF6B6B);border-radius:30rpx;padding:46rpx 30rpx;text-align:center;color:#fff;margin-bottom:24rpx;box-shadow:0 12rpx 32rpx rgba(255,107,107,.22)}.result-label{font-size:28rpx;opacity:.92}.result-money{font-size:64rpx;font-weight:900;margin:18rpx 0;line-height:1.1}.result-desc{font-size:24rpx;opacity:.86}.scheme-row{display:flex;justify-content:space-between;align-items:center;min-height:76rpx;border-bottom:1rpx solid #f3f3f3;font-size:26rpx}.scheme-row:last-child{border-bottom:0}.process-title{display:flex;justify-content:space-between;align-items:center;font-size:30rpx;font-weight:800;color:#222}.process-card{background:#F9FAFB;border-radius:16rpx;padding:20rpx;margin-top:16rpx;font-size:24rpx;line-height:1.7}.process-name{font-weight:800;color:#333}.process-formula{color:#999;margin-top:6rpx}.process-result{color:#FF6B6B;font-weight:800;margin-top:6rpx}
