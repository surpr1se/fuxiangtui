/* pages/result/result.wxss */
.result-header {
  text-align: center;
  padding: 40rpx 0;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.result-subtitle {
  font-size: 24rpx;
  color: #999;
  padding: 0 40rpx;
  line-height: 1.5;
}

.result-main-card {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.result-label {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.result-value {
  color: #fff;
  font-size: 72rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.result-desc {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

.result-summary {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.breakdown-content {
  padding-top: 16rpx;
}

.breakdown-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.breakdown-item.total {
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  font-weight: 700;
}

.breakdown-label {
  font-size: 28rpx;
  color: #666;
}

.breakdown-item.total .breakdown-label {
  color: #333;
}

.breakdown-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.breakdown-item.total .breakdown-value {
  color: #FF6B6B;
  font-size: 36rpx;
}

.process-content {
  padding-top: 16rpx;
}

.process-step {
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.process-step:last-child {
  margin-bottom: 0;
}

.process-step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.process-formula {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  font-family: monospace;
}

.process-result {
  font-size: 26rpx;
  font-weight: 600;
  color: #10B981;
}

/* 多方案对比 */
.compare-content {
  margin: 0 -24rpx -24rpx;
  padding-top: 24rpx;
}

.scheme-selector {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
  background: #F5F3FF;
  border-bottom: 1rpx solid #DDD6FE;
}

.scheme-btn {
  flex: 1;
  padding: 16rpx 8rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #E5E7EB;
  cursor: pointer;
  transition: all 0.3s;
}

.scheme-btn.active {
  background: #ECFDF5;
  border-color: #10B981;
}

.scheme-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
}

.scheme-btn.active .scheme-name {
  color: #065F46;
}

.compare-table {
  font-size: 24rpx;
}

.compare-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  border-bottom: 1rpx solid #f0f0f0;
}

.compare-row.header {
  background: #FAFAFA;
  font-weight: 600;
}

.compare-cell {
  padding: 20rpx 12rpx;
  text-align: center;
}

.compare-row.header .compare-cell {
  color: #333;
}

.compare-cell.highlight {
  background: #ECFDF5;
  color: #065F46;
  font-weight: 600;
}

.compare-cell.good {
  color: #10B981;
  font-weight: 600;
}

.compare-cell.warn {
  color: #F59E0B;
  font-weight: 600;
}

.compare-footer {
  padding: 24rpx;
  background: #F9FAFB;
  border-top: 1rpx solid #f0f0f0;
}

.compare-tip {
  font-size: 24rpx;
  color: #6B21A8;
  line-height: 1.5;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.btn-group button {
  flex: 1;
}
.forecast-row,.compare-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8rpx;padding:16rpx 0;border-bottom:1rpx solid #f2f2f2;font-size:24rpx;color:#666;text-align:center}.forecast-row text:nth-child(2),.compare-row text:nth-child(2){font-weight:700;color:#FF6B6B}.compare-row.header{font-weight:700;color:#333;background:#F9FAFB;border-radius:10rpx;padding:14rpx 0}.compare-row.active{background:#FFF5F5;border-radius:10rpx}.btn-group{display:flex;gap:16rpx;margin-top:32rpx}.btn-group button{flex:1}
