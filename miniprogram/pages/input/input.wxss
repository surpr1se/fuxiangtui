.form-title{font-size:34rpx;font-weight:700;color:#333;text-align:center;margin-bottom:24rpx}.person-line{display:flex;justify-content:space-between;font-size:26rpx;color:#666;padding:12rpx 0}.person-line text:last-child{font-weight:600;color:#333}.identity-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.identity-card{border:1rpx solid #eee;border-radius:16rpx;padding:20rpx;background:#fafafa}.identity-card.active{border-color:#FF6B6B;background:#FFF5F5}.identity-name{font-size:28rpx;font-weight:700;color:#333}.identity-desc{font-size:22rpx;color:#999;margin-top:6rpx}.delay-card{background:#FFFBEB;border:1rpx solid #FDE68A;border-radius:16rpx;padding:22rpx;color:#B45309;font-size:24rpx;line-height:1.8;margin-bottom:28rpx}.delay-title{font-size:28rpx;font-weight:700;color:#92400E;margin-bottom:8rpx}.future-title{font-size:30rpx;font-weight:700;color:#333;margin-bottom:20rpx}.future-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-bottom:18rpx}.future-tab{text-align:center;background:#f5f5f5;border-radius:999rpx;padding:12rpx 4rpx;font-size:22rpx;color:#666}.future-tab.active{background:#FF6B6B;color:#fff}.future-row,.future-total{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #f3f3f3;font-size:25rpx;color:#666}.future-total{border-bottom:none;font-weight:700;color:#333}.future-total text:last-child{color:#FF6B6B}.future-empty{text-align:center;color:#999;font-size:24rpx;padding:24rpx}
