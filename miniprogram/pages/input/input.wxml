<view class="container">
  <view class="card info-card">
    <view class="form-title">📝 补充测算信息</view>
    <view class="person-line"><text>姓名</text><text>{{personalInfo.name || '-'}}</text></view>
    <view class="person-line"><text>性别</text><text>{{gender === 'male' ? '男' : '女'}}</text></view>
    <view class="person-line"><text>个人账户累计</text><text>{{paymentSummary.personalTotalText}}</text></view>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="form-label">人员类型</text>
      <view class="radio-group">
        <view class="radio-item {{personType === 'enterprise' ? 'active' : ''}}" bindtap="selectPersonType" data-type="enterprise"><view class="radio-dot"></view><text>企业职工</text></view>
        <view class="radio-item {{personType === 'government' ? 'active' : ''}}" bindtap="selectPersonType" data-type="government"><view class="radio-dot"></view><text>机关事业单位</text></view>
      </view>
    </view>

    <view class="form-item" wx:if="{{!hideIdentity}}">
      <text class="form-label">退休身份</text>
      <view class="identity-grid">
        <view class="identity-card {{identity === '工人' ? 'active' : ''}}" bindtap="selectIdentity" data-identity="工人"><view class="identity-name">工人</view><view class="identity-desc">女工人法定50岁</view></view>
        <view class="identity-card {{identity === '干部' ? 'active' : ''}}" bindtap="selectIdentity" data-identity="干部"><view class="identity-name">干部</view><view class="identity-desc">女干部法定55岁</view></view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">退休年月</text>
      <input class="form-input" value="{{retireDate}}" placeholder="YYYY-MM" bindinput="onRetireDateInput" />
    </view>
    <view class="form-item">
      <text class="form-label">退休年龄</text>
      <input class="form-input" type="digit" value="{{retireAge}}" bindinput="onRetireAgeInput" />
      <text class="form-tip">可手动调整，退休年月会同步联动</text>
    </view>

    <view class="delay-card" wx:if="{{delayTip}}">
      <view class="delay-title">延迟退休影响参考</view>
      <view>{{delayTip.text}}</view>
      <view>{{delayTip.dateText}}</view>
      <view>{{delayTip.benefitText}}</view>
      <view>{{delayTip.breakEvenText}}</view>
    </view>

    <view class="form-item">
      <text class="form-label">视同缴费年限（年）</text>
      <input class="form-input" type="digit" value="{{visualYears}}" bindinput="onVisualYearsInput" placeholder="没有请填0" />
    </view>
    <view class="form-item">
      <text class="form-label">个人账户累计储存额（元）</text>
      <input class="form-input" type="digit" value="{{personalAccount}}" bindinput="onPersonalAccountInput" />
      <text class="form-tip">已按缴费明细基数 × 8% 自动估算，可修改</text>
    </view>
    <view class="form-item">
      <text class="form-label">上年社会平均工资（月）</text>
      <input class="form-input" type="digit" value="{{socialAvgWage}}" bindinput="onSocialAvgWageInput" />
    </view>
  </view>

  <view class="card">
    <view class="future-title">未来缴费预测</view>
    <view class="future-tabs">
      <view wx:for="{{futureModes}}" wx:key="key" class="future-tab {{futurePaymentMode === item.key ? 'active' : ''}}" bindtap="selectFutureMode" data-mode="{{item.key}}">{{item.name}}</view>
    </view>
    <view class="future-empty" wx:if="{{futureYears.length === 0}}">暂无未来缴费月份</view>
    <view class="future-row" wx:for="{{futureYears}}" wx:key="year">
      <text>{{item.year}}年 · {{item.months}}个月</text>
      <text>{{item.amountText}}</text>
    </view>
    <view class="future-total"><text>预计个人账户增加</text><text>{{futureTotalText}}</text></view>
  </view>

  <view class="btn-group">
    <button class="btn-secondary" bindtap="goBack">返回</button>
    <button class="btn-primary" bindtap="startCalculate" loading="{{isCalculating}}">开始测算</button>
  </view>
</view>
