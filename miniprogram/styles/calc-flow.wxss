.flow-page{min-height:100vh;background:#fff;padding:0 24rpx 140rpx;box-sizing:border-box;color:#333}.flow-header{height:188rpx;margin:0 -24rpx;background:linear-gradient(135deg,#FF6B6B 0%,#FF8E53 100%);color:#fff;position:relative;display:flex;align-items:flex-end;justify-content:center;padding:0 32rpx 28rpx;box-sizing:border-box}.flow-back{position:absolute;left:32rpx;bottom:30rpx;width:52rpx;height:52rpx;line-height:52rpx;text-align:center;font-size:42rpx;font-weight:500;color:#fff}.flow-title{font-size:34rpx;font-weight:800;line-height:52rpx}.flow-steps{display:flex;align-items:flex-start;justify-content:space-between;padding:54rpx 38rpx 48rpx}.flow-step{width:112rpx;text-align:center;position:relative;color:#999;flex-shrink:0}.flow-step-dot{width:58rpx;height:58rpx;border-radius:50%;background:#e5e7eb;color:#999;margin:0 auto;display:flex;align-items:center;justify-content:center;font-size:28rpx;font-weight:800;line-height:58rpx}.flow-step-text{margin-top:14rpx;font-size:24rpx;line-height:1.2;white-space:nowrap}.flow-step.active{color:#FF6B6B}.flow-step.active .flow-step-dot{background:linear-gradient(135deg,#FF6B6B,#FF8E53);color:#fff}.flow-step.done{color:#FF6B6B}.flow-step.done .flow-step-dot{background:#FF6B6B;color:#fff}.flow-line{flex:1;height:4rpx;background:#e5e7eb;margin-top:28rpx}.flow-line.active{background:#FF6B6B}.flow-card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 6rpx 24rpx rgba(0,0,0,.05)}.flow-section-title{font-size:30rpx;font-weight:800;color:#222;display:flex;align-items:center;margin-bottom:22rpx}.flow-section-title-icon{font-size:28rpx;margin-right:12rpx}.flow-row{display:flex;align-items:center;justify-content:space-between;min-height:72rpx;border-bottom:1rpx solid #f3f3f3;font-size:26rpx;color:#333}.flow-row:last-child{border-bottom:0}.flow-label{color:#666}.flow-value{color:#333;font-weight:600;text-align:right}.flow-money{color:#FF6B6B;font-weight:800}.flow-muted{color:#999}.flow-tip-card{background:#F8FAFC;border-radius:22rpx;padding:30rpx;margin-bottom:24rpx}.flow-tip-title{font-size:30rpx;font-weight:800;color:#222;margin-bottom:22rpx;display:flex;align-items:center}.flow-tip-title text{margin-right:12rpx}.flow-tip{display:flex;align-items:flex-start;font-size:28rpx;line-height:1.65;color:#333;margin:22rpx 0}.flow-check{color:#10B981;font-size:34rpx;margin-right:18rpx;line-height:1.4}.flow-btn-row{display:flex;gap:18rpx;margin-top:28rpx}.flow-btn-row button{flex:1;margin:0}.flow-primary-btn,.flow-secondary-btn{height:88rpx!important;line-height:88rpx!important;border-radius:999rpx!important;font-size:30rpx!important;font-weight:800!important;padding:0!important}.flow-primary-btn{background:linear-gradient(135deg,#FF7B6B,#FF6B6B)!important;color:#fff!important}.flow-secondary-btn{background:#f5f5f5!important;color:#666!important;border:1rpx solid #e5e5e5!important}.flow-primary-btn::after,.flow-secondary-btn::after{border:none!important}.flow-empty{text-align:center;color:#999;font-size:26rpx;padding:48rpx 20rpx;background:#fafafa;border-radius:18rpx}.flow-input{height:82rpx;background:#fff;border:1rpx solid #e5e5e5;border-radius:16rpx;padding:0 22rpx;font-size:28rpx;box-sizing:border-box}.flow-option-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.flow-option{padding:22rpx;background:#fafafa;border:1rpx solid #eee;border-radius:18rpx;text-align:center;font-size:26rpx;color:#666}.flow-option.active{background:#FFF5F5;border-color:#FF6B6B;color:#FF6B6B;font-weight:800}.flow-bottom-safe{height:24rpx}
