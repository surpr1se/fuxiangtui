page{background:#f7f7f7;color:#333;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif}.page{min-height:100vh;padding:24rpx 24rpx 140rpx;box-sizing:border-box}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 6rpx 24rpx rgba(0,0,0,.05)}.hero{background:linear-gradient(135deg,#FF7B6B 0%,#FF6B6B 100%);border-radius:30rpx;padding:38rpx 30rpx;color:#fff;margin-bottom:24rpx;box-shadow:0 12rpx 32rpx rgba(255,107,107,.22)}.hero-title{font-size:44rpx;font-weight:800}.hero-desc{font-size:26rpx;opacity:.88;margin-top:10rpx;line-height:1.5}.section-title{font-size:30rpx;font-weight:700;color:#333;margin:30rpx 0 18rpx}.btn-primary{background:linear-gradient(135deg,#FF7B6B,#FF6B6B);color:#fff;border:0;border-radius:999rpx;height:88rpx;line-height:88rpx;font-size:30rpx;font-weight:700}.btn-secondary{background:#f5f5f5;color:#666;border:1rpx solid #e5e5e5;border-radius:999rpx;height:88rpx;line-height:88rpx;font-size:30rpx}.btn-row{display:flex;gap:18rpx;margin-top:28rpx}.btn-row button{flex:1}.muted{color:#999}.money{color:#FF6B6B;font-weight:800}.row{display:flex;justify-content:space-between;align-items:center;padding:18rpx 0;border-bottom:1rpx solid #f3f3f3;font-size:26rpx}.row:last-child{border-bottom:0}.tag{display:inline-block;background:#FFF1F2;color:#FF6B6B;border-radius:999rpx;padding:6rpx 14rpx;font-size:22rpx}.empty{text-align:center;color:#999;padding:70rpx 20rpx;font-size:26rpx}.form-item{margin-bottom:28rpx}.form-label{display:block;font-size:28rpx;font-weight:700;margin-bottom:14rpx}.input{height:86rpx;background:#fff;border:1rpx solid #e5e5e5;border-radius:16rpx;padding:0 22rpx;font-size:28rpx;box-sizing:border-box}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14rpx}.option{padding:22rpx;background:#fafafa;border:1rpx solid #eee;border-radius:18rpx;text-align:center;font-size:26rpx}.option.active{background:#FFF5F5;border-color:#FF6B6B;color:#FF6B6B;font-weight:700}.modal-mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.45);z-index:999;display:flex;align-items:center;justify-content:center;padding:32rpx}.modal{width:100%;max-height:82vh;overflow:auto;background:#fff;border-radius:28rpx;padding:30rpx;box-sizing:border-box}.modal-title{text-align:center;font-size:32rpx;font-weight:800;margin-bottom:24rpx}
